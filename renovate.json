{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rfnry/tools:default"],
  "github-actions": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/)templates/[^/]+\\.yml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)scripts/plan\\.sh$/"],
      "matchStrings": ["(?<depName>pgvector/pgvector):(?<currentValue>pg\\d+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^pg(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["pgvector/pgvector"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
